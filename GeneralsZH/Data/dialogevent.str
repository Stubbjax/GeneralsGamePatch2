US: "<Cheering>"
DE: "<Jubelgeschrei>"
FR: "<Acclamations>"
ES: "\n<Vítores>"
IT: "\n*"
KO: "와아아!"
ZH: "\n<歡呼>"
BP: "***"
PL: "***"
END

