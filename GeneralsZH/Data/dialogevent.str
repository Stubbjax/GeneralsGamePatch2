BP: "***"
PL: "***"
END

DIALOGEVENT:MisGLA04Dispatcher06Subtitle
US: "*American forces are on their way"
DE: "*American forces are on their way"
FR: "***"
ES: "\nLas fuerzas americanas están en camino."
